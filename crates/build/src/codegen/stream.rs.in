/// Read consecutive Pojoc envelopes and reply with one latest-version envelope
/// per request. Flush each reply and return successfully on EOF between frames.
/// Reject requests whose declared payload exceeds `max_payload_bytes`.
pub fn serve(
    input: &mut impl std::io::BufRead,
    output: &mut impl std::io::Write,
    max_payload_bytes: usize,
) -> std::io::Result<()> {
    use std::io::{self, BufRead, Read};

    fn read_frame(
        input: &mut impl BufRead,
        frame: &mut Vec<u8>,
        max_payload_bytes: usize,
    ) -> io::Result<bool> {
        frame.clear();
        let Some(mut byte) = input.bytes().next().transpose()? else {
            return Ok(false);
        };
        frame.push(byte);
        while byte & 0x80 != 0 {
            input.read_exact(std::slice::from_mut(&mut byte))?;
            if frame.len() == 9 && byte > 1 {
                return Err(io::Error::new(
                    io::ErrorKind::InvalidData,
                    "invalid envelope version varint",
                ));
            }
            frame.push(byte);
        }

        let mut length = [0; 4];
        input.read_exact(&mut length)?;
        let payload_len = u32::from_le_bytes(length) as usize;
        let frame_len = (frame.len() + length.len())
            .checked_add(payload_len)
            .filter(|_| payload_len <= max_payload_bytes)
            .ok_or_else(|| {
                io::Error::new(io::ErrorKind::InvalidData, "envelope payload exceeds limit")
            })?;
        frame.extend_from_slice(&length);
        let payload_start = frame.len();
        frame.resize(frame_len, 0);
        input.read_exact(&mut frame[payload_start..])?;
        Ok(true)
    }

    let codec_error = |err| io::Error::new(io::ErrorKind::InvalidData, err);
    let latest = *supported_versions().last().unwrap();
    let mut request = Vec::new();
    let mut response = Vec::new();
    while read_frame(input, &mut request, max_payload_bytes)? {
        let value = decode(&request).map_err(codec_error)?;
        response.clear();
        encode_for_version(&mut response, &value, latest).map_err(codec_error)?;
        output.write_all(&response)?;
        output.flush()?;
    }
    Ok(())
}
