/// Read consecutive Pojoc envelopes and reply with one latest-version envelope
/// per request. Flush each reply and return successfully on EOF between frames.
/// Reject requests whose declared payload exceeds `max_payload_bytes`.
pub fn serve(
    input: &mut impl std::io::BufRead,
    output: &mut impl std::io::Write,
    max_payload_bytes: usize,
) -> std::io::Result<()> {
    use std::io::{self, BufRead, Read};

    fn codec_error(err: Error) -> io::Error {
        io::Error::new(io::ErrorKind::InvalidData, err)
    }

    fn read_stream_varint(input: &mut impl Read, first: u8) -> io::Result<([u8; 10], usize)> {
        let mut bytes = [0; 10];
        bytes[0] = first;
        let mut len = 1;
        while bytes[len - 1] & 0x80 != 0 && len < bytes.len() {
            input.read_exact(&mut bytes[len..len + 1])?;
            len += 1;
        }
        Ok((bytes, len))
    }

    fn read_header(
        input: &mut impl BufRead,
        max_payload_bytes: usize,
    ) -> io::Result<Option<(u64, usize)>> {
        let Some(first) = input.bytes().next().transpose()? else {
            return Ok(None);
        };
        let (version_bytes, version_len) = read_stream_varint(input, first)?;
        if version_len == 10 && version_bytes[9] > 1 {
            return Err(io::Error::new(
                io::ErrorKind::InvalidData,
                "invalid envelope version varint",
            ));
        }
        let version = read_varint64(&version_bytes[..version_len], &mut 0).map_err(codec_error)?;

        let mut length = [0; 4];
        input.read_exact(&mut length)?;
        let payload_len = u32::from_le_bytes(length) as usize;
        if payload_len > max_payload_bytes
            || (version_len + length.len()).checked_add(payload_len).is_none()
        {
            return Err(io::Error::new(
                io::ErrorKind::InvalidData,
                "envelope payload exceeds limit",
            ));
        }
        Ok(Some((version, payload_len)))
    }

    fn read_buffered_reply(
        input: &mut impl BufRead,
        version: u64,
        payload_len: usize,
        request: &mut Vec<u8>,
        response: &mut Vec<u8>,
    ) -> io::Result<usize> {
        request.clear();
        request.resize(payload_len, 0);
        input.read_exact(request)?;
        let value = decode_payload(version, request).map_err(codec_error)?;
        response.clear();
        let latest = *supported_versions().last().unwrap();
        encode_for_version(response, &value, latest).map_err(codec_error)?;
        Ok(response.len())
    }

    // BYTE_ARRAY_STREAM
    // HYBRID_STREAM
    let mut request = Vec::new();
    let mut response = Vec::new();
    while let Some((version, payload_len)) = read_header(input, max_payload_bytes)? {
        // STREAM_REPLY
        if let Some(reply_len) = reply_len {
            output.write_all(&response[..reply_len])?;
        }
        output.flush()?;
    }
    Ok(())
}
