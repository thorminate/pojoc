{
  "name": "pojoc-typescript-bench",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "node generate.mjs",
    "fixtures": "node fixtures.mjs",
    "typecheck": "deno check --no-config --node-modules-dir=manual verify.ts benchmark_edge.ts \"generated/*.ts\"",
    "test:node": "node verify.ts",
    "test:bun": "bun run verify.ts",
    "bench:node": "node benchmark.ts",
    "bench:bun": "bun run benchmark.ts",
    "bench:edge:node": "node benchmark_edge.ts",
    "bench:edge:bun": "bun run benchmark_edge.ts"
  },
  "dependencies": {
    "protobufjs": "8.8.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "prettier": "3.6.2"
  }
}
