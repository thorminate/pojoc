schema ReadOffsets {
  version 1 {
    bitset WideFlags { F0, F1, F2, F3, F4, F5, F6, F7, F8, F9, F10, F11, F12, F13, F14, F15, F16 }
    fields {
      flags: seekable WideFlags = 0
      snapshot: seekable WideFlags = 0
      stamp: seekable u16 = 0
      blob: seekable [u8] = []
      retired: seekable [u32] = []
      map: seekable map<u32, u16>(2)
      marker: seekable string = ""
    }
  }
  version 2 {
    bitset WideFlags extends WideFlags@1 {
      + F17
      + F18
      + F19
      + F20
      + F21
      + F22
      + F23
      + F24
      + F25
      + F26
      + F27
      + F28
      + F29
      + F30
      + F31
      + F32
    }
    diff {
      ~ flags: seekable WideFlags
      ~ stamp: seekable u32
      - retired
    }
  }
}
