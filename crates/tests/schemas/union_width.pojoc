/// Minimal schema exercising union discriminant width transitions, kept
/// separate so crossing the 256-variant threshold doesn't bloat edge.pojoc.
schema UnionWidth {
  version 1 {
    union Big {
      V0: i32,
      V1: i32,
      V2: i32,
    }
    fields {
      x: Big
    }
  }
