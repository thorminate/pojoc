use std::io;
use std::process::ExitCode;

const MAX_PAYLOAD_BYTES: usize = 16 * 1024 * 1024;
const USAGE: &str = "Usage: <binary> serve --stdio";

fn serve_stdio(mode: Mode) -> io::Result<()> {
    let mut input = io::stdin().lock();
    let output = io::stdout();

    #[cfg(any(unix, windows))]
    {
        use std::io::IsTerminal;
        #[cfg(unix)]
        use std::os::fd::AsFd;
        #[cfg(windows)]
        use std::os::windows::io::AsHandle;

        // Avoid splitting a binary reply on embedded newlines.
        if !output.is_terminal() {
            #[cfg(unix)]
            let handle = output.as_fd().try_clone_to_owned();
            #[cfg(windows)]
            let handle = output.as_handle().try_clone_to_owned();
            if let Ok(handle) = handle {
                let mut output = std::fs::File::from(handle);
                return mode.run(&mut input, &mut output);
            }
        }
    }

    mode.run(&mut input, &mut output.lock())
}

fn main() -> ExitCode {
    let args: Vec<_> = std::env::args_os().skip(1).collect();
    let mode = match args.as_slice() {
        [help] if help == "--help" || help == "-h" => {
            println!("{USAGE}{}", Mode::USAGE_SUFFIX);
            return ExitCode::SUCCESS;
        }
        [serve, stdio, options @ ..] if serve == "serve" && stdio == "--stdio" => {
            Mode::parse(options)
        }
        _ => None,
    };
    let Some(mode) = mode else {
        eprintln!("{USAGE}{}", Mode::USAGE_SUFFIX);
        return ExitCode::FAILURE;
    };
    if let Err(err) = serve_stdio(mode) {
        eprintln!("{err}");
        return ExitCode::FAILURE;
    }
    ExitCode::SUCCESS
}
