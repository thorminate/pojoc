enum Mode {
    RoundTrip,
    #[cfg(feature = "sidecar-json")]
    Encode,
    #[cfg(feature = "sidecar-json")]
    Decode,
}

impl Mode {
    const USAGE_SUFFIX: &str = if cfg!(feature = "sidecar-json") {
        " [encode|decode]"
    } else {
        ""
    };

    fn parse(args: &[std::ffi::OsString]) -> Option<Self> {
        match args {
            [] => Some(Self::RoundTrip),
            #[cfg(feature = "sidecar-json")]
            [mode] if mode == "encode" => Some(Self::Encode),
            #[cfg(feature = "sidecar-json")]
            [mode] if mode == "decode" => Some(Self::Decode),
            _ => None,
        }
    }

    fn run(self, input: &mut impl io::BufRead, output: &mut impl io::Write) -> io::Result<()> {
        match self {
            Self::RoundTrip => codec::serve(input, output, MAX_PAYLOAD_BYTES),
            #[cfg(feature = "sidecar-json")]
            Self::Encode => json::encode(input, output),
            #[cfg(feature = "sidecar-json")]
            Self::Decode => json::decode(input, output),
        }
    }
}

#[cfg(feature = "sidecar-json")]
mod json {
    use super::{MAX_PAYLOAD_BYTES, codec};
    use std::io::{self, BufRead, Read, Write};

    const MAX_JSON_BYTES: usize = 64 * 1024 * 1024;

    fn invalid_data(err: impl Into<Box<dyn std::error::Error + Send + Sync>>) -> io::Error {
        io::Error::new(io::ErrorKind::InvalidData, err)
    }

    pub(super) fn encode(input: &mut impl BufRead, output: &mut impl Write) -> io::Result<()> {
        let latest = *codec::supported_versions().last().unwrap();
        let mut record = Vec::new();
        let mut envelope = Vec::new();
        loop {
            record.clear();
            let mut limited = (&mut *input).take((MAX_JSON_BYTES + 1) as u64);
            if limited.read_until(b'\n', &mut record)? == 0 {
                return Ok(());
            }
            let line = record.strip_suffix(b"\n").unwrap_or(&record);
            if line.len() > MAX_JSON_BYTES {
                return Err(invalid_data("JSON record exceeds limit"));
            }
            // Borrow strings from a parsed record, including strings with JSON escapes.
            let json: serde_json::Value = serde_json::from_slice(line).map_err(invalid_data)?;
            let value = serde::Deserialize::deserialize(&json).map_err(invalid_data)?;
            envelope.clear();
            codec::encode_for_version(&mut envelope, &value, latest).map_err(invalid_data)?;
            let payload = codec::runtime::read_envelope(&envelope, &mut 0).map_err(invalid_data)?;
            if payload.payload.len() > MAX_PAYLOAD_BYTES {
                return Err(invalid_data("envelope payload exceeds limit"));
            }
            output.write_all(&envelope)?;
            output.flush()?;
        }
    }

    pub(super) fn decode(input: &mut impl BufRead, output: &mut impl Write) -> io::Result<()> {
        let mut record = Vec::new();
        codec::serve_decode(input, MAX_PAYLOAD_BYTES, |value| {
            record.clear();
            serde_json::to_writer(&mut record, &value).map_err(invalid_data)?;
            record.push(b'\n');
            output.write_all(&record)?;
            output.flush()
        })
    }
}
